recipe_version: "1"
# Speed review 2026-09-09 (see ~/.claude memory + session notes):
#  * --long-prefill-token-threshold 2048 caps EVERY prefill chunk at 2048 tok/step
#    (v1 scheduler.py:472), so --max-num-batched-tokens 8192 is never reached by a
#    single request. Cost is uncertain: tonyd2wild's GLM-5.3-Flash TP4 recipe saw
#    +52-79% prefill from 8192->16384 chunks. Trade-off: the concurrent stream's
#    inter-token stall grows from ~4 s to ~16 s. Kept at 2048 here; A/B with
#    glm-53-comms-v3-prefill8k (threshold 8192) MEASURED 2026-09-09: 514 tok/s vs
#    498-517 -> no gain. Keep 2048.
#  * max-num-seqs 2 -> 4: KV pool is 657,664 tokens (2569 blocks x 64 x DCP4), so
#    4 x ~120K typical contexts fit; watch vllm:num_preemptions_total after launch.
#  * VLLM_KZ_TRIM_AFTER_LOAD=1: fork hook, gc + malloc_trim in workers after load.
name: GLM-5.3-comms-v2
description: "glm-53-comms + max-num-seqs 4 (queue tail) + host-memory trim after load (swap pressure). Speed review 2026-09-09."

model: /models/GLM-5.3-Tech2wild
container: glm-eldritch-b12x:20260701-arm64

defaults:
  port: 8000
  host: 0.0.0.0
  tensor_parallel: 4
  gpu_memory_utilization: 0.88
  max_model_len: 327680
  max_num_batched_tokens: 8192

env:
  NCCL_NET: IB
  NCCL_IB_DISABLE: "0"
  NCCL_IB_HCA: "mlx5_0,mlx5_2"
  NCCL_SOCKET_IFNAME: "enP7s7,enp1s0f0np0,enP2p1s0f0np0"
  GLOO_SOCKET_IFNAME: "enp1s0f0np0"
  NCCL_IB_GID_INDEX: "-1"   # GID tables are asymmetric: v2 at idx3 on .12/.13, idx4 on .11/.14

  CUTE_DSL_ARCH: "sm_121a"
  VLLM_USE_V2_MODEL_RUNNER: "1"
  VLLM_USE_B12X_SPARSE_INDEXER: "1"
  VLLM_DCP_SHARD_DRAFT: "1"
  NCCL_MAX_NCHANNELS: "4"
  NCCL_MIN_NCHANNELS: "4"
  CUDA_DEVICE_MAX_CONNECTIONS: "32"
  VLLM_MARLIN_USE_ATOMIC_ADD: "1"
  VLLM_USE_RAY_COMPILED_DAG_OVERLAP_COMM: "1"
  PYTORCH_CUDA_ALLOC_CONF: expandable_segments:True
  RAY_memory_monitor_refresh_ms: "0"
  NCCL_CUMEM_ENABLE: "0"
  NCCL_CROSS_NIC: "1"
  NCCL_IGNORE_CPU_AFFINITY: "1"
  NCCL_BUFFSIZE: "16777216"
  OMP_NUM_THREADS: "8"
  # Fork hook: gc + malloc_trim in each worker after weight load. This node runs
  # with ~1 GB MemAvailable and 5.5 GB swapped (2.2 GB of it the GPU worker).
  VLLM_KZ_TRIM_AFTER_LOAD: "1"
  TORCH_CUDA_ARCH_LIST: "12.1a"
  VLLM_ALLOW_LONG_MAX_MODEL_LEN: "1"

  HF_HUB_OFFLINE: "1"
  TRANSFORMERS_OFFLINE: "1"
  VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS: "1800"

command: |
  vllm serve /models/GLM-5.3-Tech2wild \
    --served-model-name glm5.3 \
    --quantization compressed-tensors \
    --tensor-parallel-size 4 \
    --decode-context-parallel-size 4 \
    --dcp-comm-backend ag_rs \
    --attention-backend B12X_MLA_SPARSE \
    --speculative-config '{{"method":"mtp","num_speculative_tokens":4}}' \
    --kv-cache-dtype fp8_ds_mla \
    --kv-cache-memory-bytes 9000000000 \
    --max-model-len 327680 \
    --max-num-batched-tokens 8192 \
    --max-num-seqs 4 \
    --compilation-config '{{"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["all"],"pass_config":{{"fuse_gemm_comms":true}}}}' \
    --max-cudagraph-capture-size 32 \
    --async-scheduling \
    --long-prefill-token-threshold 2048 \
    --gpu-memory-utilization 0.88 \
    --hf-overrides '{{"index_topk_pattern":"FFFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSS"}}' \
    --host {host} \
    --port {port} \
    --trust-remote-code \
    --reasoning-parser glm45 \
    --tool-call-parser glm47 \
    --enable-auto-tool-choice \
    --enable-prefix-caching \
    --distributed-executor-backend ray

mods:
  - mods/tonyd2wild-glm52-mtp-patches
  - mods/fix-indexer-mtp-overhang
