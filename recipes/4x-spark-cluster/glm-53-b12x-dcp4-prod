recipe_version: "1"
# MEASURED 2026-09-09 19:35 (this exact recipe, 9 GB KV): pool 657,664 tokens; step 115-121 ms;
# code 33-34 / prose 21.6 / count 40.6 tok/s; decode@32K 35.8; 30K cold prefill 818 tok/s;
# MemAvailable after bench: head 1.1 GB, workers 2.3-3.1 GB. Coherent. Serving as production.
# PRODUCTION CANDIDATE 2026-09-09: GLM-5.3 743B Int4-Int8Mix on eugr/spark-vllm-b12x
# nightly-20260908 (local-inference-lab/vllm dev/jovian-judgement + b12x 1.3.0) with
# mods/fix-dsv32-dcp-combine (see its README). TP4 + DCP4, MTP k=4, B12X sparse MLA,
# fp8_ds_mla KV, RoCEnante one-shot RDMA allreduce, full-CKV-gather prefill.
# Same as glm-53-b12x-nightly-dcpfix but KV 9 GB (=> ~657K-token pool, 2 x 327K) and
# gpu-memory-utilization 0.88, i.e. the original production memory budget.
# Sweep 2026-09-09 (5 variants, 8 GB KV): k=5, 8192 chunks, interleave 64, a2a = no gain or worse;
# RoCE DCP gathers = keep (step 115-122 ms, code 32-33 / prose 21 / count 42, decode@32K 35.6).
# max-num-batched-tokens 4096 (was 8192): prefill chunks are capped at 2048 by the threshold
# anyway, so this only trims activation workspace to make room for the 9 GB KV budget.
#   cd ~/spark-vllm-docker && ./run-recipe.py recipes/4x-spark-cluster/glm-53-b12x-dcp4-prod --no-ray
# Rollback: ./run-recipe.py recipes/4x-spark-cluster/glm-53-comms-v2   (eldritch image, Ray)
name: GLM-5.3-b12x-dcp4-prod
description: "PRODUCTION: GLM-5.3 Int4-Int8Mix, nightly b12x stack + DCP fix mod, TP4+DCP4, MTP4, RoCEnante, 327K ctx, 9 GB KV (~657K pool), 4 seqs."

model: /models/GLM-5.3-Tech2wild
container: eugr/spark-vllm-b12x:nightly-20260908

defaults:
  port: 8000
  host: 0.0.0.0
  tensor_parallel: 4
  gpu_memory_utilization: 0.88
  max_model_len: 327680
  max_num_batched_tokens: 4096

env:
  NCCL_NET: IB
  NCCL_IB_DISABLE: "0"
  NCCL_IB_HCA: "mlx5_0,mlx5_2"
  NCCL_SOCKET_IFNAME: "enP7s7,enp1s0f0np0,enP2p1s0f0np0"
  GLOO_SOCKET_IFNAME: "enp1s0f0np0"
  NCCL_IB_GID_INDEX: "-1"
  NCCL_MAX_NCHANNELS: "4"
  NCCL_MIN_NCHANNELS: "4"
  NCCL_CUMEM_ENABLE: "0"
  NCCL_CROSS_NIC: "1"
  NCCL_IGNORE_CPU_AFFINITY: "1"
  NCCL_BUFFSIZE: "16777216"

  # b12x one-shot RoCE collectives (multi-node TP). HCAs come from NCCL_IB_HCA.
  VLLM_ENABLE_ROCE_ALLREDUCE: "1"
  # sweep winner 2026-09-09: DCP-group gathers via the RoCE runtime (mod part 6), ~-5 ms/step
  VLLM_ROCE_DCP_COLLECTIVES: "1"
  # prefill via full-CKV gather (opened to glm_moe_dsa by the mod)
  VLLM_B12X_MLA_CKV_GATHER: "1"
  VLLM_B12X_MLA_CKV_GATHER_DSA: "1"
  VLLM_B12X_MLA_CKV_GATHER_MAX_TOKENS: "524288"
  VLLM_ROCE_ALLREDUCE_MAX_SIZE: "2MB"
  VLLM_ENABLE_PCIE_ALLREDUCE: "0"

  CUTE_DSL_ARCH: "sm_121a"
  VLLM_USE_V2_MODEL_RUNNER: "1"
  VLLM_USE_AOT_COMPILE: "1"
  VLLM_SPARSE_INDEXER_MAX_LOGITS_MB: "256"
  VLLM_MARLIN_USE_ATOMIC_ADD: "1"
  VLLM_ALLOW_LONG_MAX_MODEL_LEN: "1"
  VLLM_WORKER_MULTIPROC_METHOD: "spawn"
  CUDA_DEVICE_MAX_CONNECTIONS: "32"
  PYTORCH_CUDA_ALLOC_CONF: expandable_segments:True
  OMP_NUM_THREADS: "8"
  TORCH_CUDA_ARCH_LIST: "12.1a"

  HF_HUB_OFFLINE: "1"
  TRANSFORMERS_OFFLINE: "1"
  VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS: "1800"

command: |
  export B12X_ROCE_GID_INDEX=$(for i in 0 1 2 3 4 5 6 7; do g=$(cat /sys/class/infiniband/mlx5_0/ports/1/gids/$i 2>/dev/null); t=$(cat /sys/class/infiniband/mlx5_0/ports/1/gid_attrs/types/$i 2>/dev/null); case "$g" in *:ffff:*) [ "$t" = "RoCE v2" ] && {{ echo $i; break; }};; esac; done)
  echo "[recipe] B12X_ROCE_GID_INDEX=$B12X_ROCE_GID_INDEX on $(hostname)"
  vllm serve /models/GLM-5.3-Tech2wild \
    --served-model-name glm5.3 \
    --quantization compressed-tensors \
    --tensor-parallel-size 4 \
    --decode-context-parallel-size 4 \
    --dcp-comm-backend ag_rs \
    --attention-backend B12X \
    --speculative-config '{{"method":"mtp","num_speculative_tokens":4,"attention_backend":"B12X","quantization":"compressed-tensors"}}' \
    --kv-cache-dtype fp8_ds_mla \
    --kv-cache-memory-bytes 9000000000 \
    --max-model-len 327680 \
    --max-num-batched-tokens 4096 \
    --max-num-seqs 4 \
    --compilation-config '{{"cudagraph_mode":"FULL_AND_PIECEWISE","custom_ops":["all"]}}' \
    --max-cudagraph-capture-size 32 \
    --async-scheduling \
    --long-prefill-token-threshold 2048 \
    --gpu-memory-utilization 0.88 \
    --hf-overrides '{{"index_topk_pattern":"FFFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSSFSSS"}}' \
    --host {host} \
    --port {port} \
    --trust-remote-code \
    --reasoning-parser glm45 \
    --tool-call-parser glm47 \
    --enable-auto-tool-choice \
    --enable-prefix-caching \
    --no-enable-flashinfer-autotune

mods:
  - mods/fix-dsv32-dcp-combine
