[Unit]
Description=vLLM DeepSeek-V4.1-Flash (4x DGX Spark, TP4, DSpark k=5, node-local Engram)
After=docker.service network-online.target nfs-server.service
Requires=docker.service
Wants=network-online.target
Conflicts=vllm-glm53.service
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
User=jeff
Group=jeff
WorkingDirectory=/home/jeff/spark-vllm-docker
Environment=HOME=/home/jeff
ExecStartPre=/home/jeff/spark-vllm-docker/systemd/wait-for-workers.sh
ExecStart=/home/jeff/spark-vllm-docker/launch/deepseek-v41-flash-local.sh
ExecStop=/home/jeff/spark-vllm-docker/launch-cluster.sh stop
TimeoutStartSec=1500
TimeoutStopSec=300
Restart=on-failure
RestartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
