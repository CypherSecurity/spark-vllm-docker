+class ReplicatedBAProj(torch.nn.Module):
+    """Marlin TP=4 fix wrapper for Qwen3.5 in_proj_ba.
+
+    Qwen3.5 packs in_proj_b and in_proj_a (each [hidden_size, num_v_heads])
+    into MergedColumnParallelLinear with output_sizes=[num_v_heads]*2.
+    At TP=4 with num_v_heads=64, per-rank output = 128/4 = 32, which violates
+    Marlin's min_thread_n=64.
+
+    This wrapper uses two ReplicatedLinear modules (no TP shard, no Marlin
+    constraint), and slices outputs to local TP partition in forward.
+    Exposes the same callable interface and .output_sizes attribute so the
+    upstream gdn_in_proj custom op and forward() code work unchanged.
+    """
+
+    def __init__(self, in_proj_b, in_proj_a, num_v_heads, tp_size, tp_rank):
+        super().__init__()
+        self.in_proj_b = in_proj_b
+        self.in_proj_a = in_proj_a
+        self.output_sizes = [num_v_heads, num_v_heads]
+        self._tp_size = tp_size
+        self._tp_rank = tp_rank
+        self._chunk = num_v_heads // tp_size
+
+    def forward(self, hidden_states):
+        b_full, _ = self.in_proj_b(hidden_states)
+        a_full, _ = self.in_proj_a(hidden_states)
+        start = self._tp_rank * self._chunk
+        end = start + self._chunk
+        ba = torch.cat([
+            b_full[:, start:end],
+            a_full[:, start:end],
+        ], dim=-1)
+        return ba, None
+
